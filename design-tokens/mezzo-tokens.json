{
  "$schema": "https://design-tokens.org",
  "$description": "Mezzo Design Tokens — Lantern visual system (docs/prd/range-ring-and-lantern-refresh.md §4). Mirrors design-tokens/mezzo-tokens.css, which is the source of truth.",
  "color": {
    "role": {
      "$description": "Semantic color roles, one job each. Translucent uses mix a role with transparent via color-mix(). Chartreuse is the website's brand accent; inside the Companion it only ever means the over-range band.",
      "bg": {
        "$value": "#2D2E31",
        "$type": "color",
        "$description": "Page and Companion screen background"
      },
      "bg-slate": {
        "$value": "#38393C",
        "$type": "color",
        "$description": "Raised slate: decision states, hero tile, Get started band"
      },
      "bg-decision": {
        "$value": "{color.role.bg-slate}",
        "$type": "color",
        "$description": "Decision-state background"
      },
      "bg-menu": {
        "$value": "#3C3D40",
        "$type": "color",
        "$description": "Menu panel (Ready's profile selector)"
      },
      "accent": {
        "$value": "#DEDE65",
        "$type": "color",
        "$description": "Chartreuse"
      },
      "text": {
        "$value": "#F3EBDE",
        "$type": "color",
        "$description": "Cream: headings, main text"
      },
      "link": {
        "$value": "#CEE2C4",
        "$type": "color",
        "$description": "Sage: text links, focus rings, bullets"
      },
      "text-muted": {
        "$value": "#B0AB9E",
        "$type": "color",
        "$description": "Body, captions, labels"
      },
      "voice": {
        "$value": "#8E897B",
        "$type": "color",
        "$description": "Range Ring voice circle"
      },
      "text-soft": {
        "$value": "{color.role.text}",
        "$type": "color",
        "$description": "Companion body text, controls"
      },
      "label": {
        "$value": "{color.role.text-muted}",
        "$type": "color",
        "$description": "Small uppercase labels"
      },
      "link-quiet": {
        "$value": "{color.role.link}",
        "$type": "color",
        "$description": "Low-emphasis text actions"
      },
      "notice": {
        "$value": "{color.role.link}",
        "$type": "color",
        "$description": "Calibration status, name-collision notice; never chartreuse"
      },
      "on-accent": {
        "$value": "#2D2E31",
        "$type": "color",
        "$description": "Charcoal text on chartreuse or cream fills"
      },
      "bg-menu-hover": {
        "$value": "#46474A",
        "$type": "color",
        "$description": "Selector trigger hover"
      },
      "bg-raised": {
        "$value": "{color.role.bg-decision}",
        "$type": "color",
        "$description": "Result card, toast, tooltip"
      },
      "overlay": {
        "$value": "#FFFFFF",
        "$type": "color",
        "$description": "Translucent fills and hairlines on dark"
      },
      "shadow": {
        "$value": "#000000",
        "$type": "color",
        "$description": "Shadows and scrims"
      }
    },
    "button": {
      "primary-bg": {
        "$value": "{color.role.accent}",
        "$type": "color",
        "$description": "Website primary; the Companion overrides this to {color.role.text}"
      },
      "primary-text": {
        "$value": "{color.role.on-accent}",
        "$type": "color"
      },
      "secondary-border": {
        "$value": "color-mix(in srgb, #F3EBDE 30%, transparent)",
        "$type": "color",
        "$description": "1px cream outline at 30%"
      }
    }
  },
  "font": {
    "family": {
      "display": {
        "$value": "'Geist', system-ui, sans-serif",
        "$type": "fontFamily"
      },
      "body": {
        "$value": "'Geist', system-ui, sans-serif",
        "$type": "fontFamily"
      },
      "mono": {
        "$value": "'Geist Mono', ui-monospace, monospace",
        "$type": "fontFamily",
        "$description": "Small uppercase labels only"
      }
    },
    "weight": {
      "light": {
        "$value": 300,
        "$type": "fontWeight"
      },
      "regular": {
        "$value": 400,
        "$type": "fontWeight"
      },
      "medium": {
        "$value": 500,
        "$type": "fontWeight"
      },
      "semibold": {
        "$value": 600,
        "$type": "fontWeight"
      }
    },
    "tracking": {
      "heading": {
        "$value": "-0.04em",
        "$type": "dimension"
      },
      "label": {
        "$value": "0.12em",
        "$type": "dimension"
      }
    }
  },
  "spacing": {
    "nav-padding": {
      "$value": "24px 32px",
      "$type": "spacing",
      "$description": "Nav internal padding"
    },
    "page-gap": {
      "$value": "48px",
      "$type": "spacing",
      "$description": "Gap from nav component to first page content (2x nav padding)"
    },
    "section-gap": {
      "$value": "72px",
      "$type": "spacing",
      "$description": "4.5rem — between major sections"
    },
    "heading-to-content": {
      "$value": "40px",
      "$type": "spacing",
      "$description": "2.5rem — section heading to section body"
    },
    "circle-to-button": {
      "$value": "48px",
      "$type": "spacing",
      "$description": "Monitoring circle to Stop button"
    },
    "button-to-microcopy": {
      "$value": "16px",
      "$type": "spacing",
      "$description": "CTA to privacy/microcopy line"
    },
    "footer-padding": {
      "$value": "20px 32px",
      "$type": "spacing"
    }
  },
  "radius": {
    "control": {
      "$value": "3px",
      "$type": "borderRadius",
      "$description": "Buttons and inputs; no pills"
    },
    "cta": {
      "$value": "{radius.control}",
      "$type": "borderRadius"
    },
    "pill": {
      "$value": "{radius.control}",
      "$type": "borderRadius"
    },
    "icon-btn": {
      "$value": "{radius.control}",
      "$type": "borderRadius"
    },
    "card": {
      "$value": "10px",
      "$type": "borderRadius"
    }
  },
  "shadow": {
    "pip-window": {
      "$value": "0 4px 24px rgba(0, 0, 0, 0.25)",
      "$type": "boxShadow"
    }
  },
  "animation": {
    "hover-transition": {
      "$value": "all 0.2s ease",
      "$type": "transition"
    },
    "nav-transition": {
      "$value": "background 0.4s, box-shadow 0.4s",
      "$type": "transition"
    },
    "reveal-duration": {
      "$value": "0.7s",
      "$type": "duration"
    },
    "reveal-easing": {
      "$value": "ease",
      "$type": "cubicBezier"
    },
    "reveal-offset": {
      "$value": "16px",
      "$type": "dimension",
      "$description": "translateY distance for scroll reveal"
    },
    "pulse-dot": {
      "$value": "2s ease-in-out infinite",
      "$type": "transition",
      "$description": "Hanko dot pulse for PiP active state"
    }
  }
}
