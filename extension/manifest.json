{
  "manifest_version": 3,
  "name": "Mezzo — Meeting Volume Reminder",
  "version": "1.0.0",
  "description": "Detects when you join Google Meet, Zoom, or Microsoft Teams and offers to launch Mezzo to monitor your speaking volume.",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "permissions": ["storage"],

  "host_permissions": [
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://mezzo-one.vercel.app/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*"
      ],
      "js": ["content-scripts/meeting-detect.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
