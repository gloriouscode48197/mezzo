{
  "manifest_version": 3,
  "name": "Mezzo — Meeting Volume Reminder",
  "version": "1.0.4",
  "description": "Detects when you join Google Meet, Zoom, or Microsoft Teams and offers to launch Mezzo to monitor your speaking volume.",

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "64": "icons/icon-64.png",
      "128": "icons/icon-128.png"
    }
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "permissions": ["storage"],

  "host_permissions": [
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://mezzo-one.vercel.app/*"
  ],

  "web_accessible_resources": [
    {
      "resources": ["popup/fonts/geist-latin.woff2"],
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*"
      ]
    }
  ],

  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*"
      ],
      "js": ["content-scripts/meeting-detect.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://mezzo-one.vercel.app/*"],
      "js": ["content-scripts/mezzo-page-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
